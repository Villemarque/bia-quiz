# Copy this file to group_vars/all.yml and edit it. Do not commit that file.

# Users managed on the host. Keys are read from files on the controller.
bia_users:
  - name: bia-quiz
    system: true
    group: bia-quiz
    home: /var/lib/bia-quiz
    shell: /usr/sbin/nologin
    create_home: true
    home_mode: "0750"
    ssh_authorized_key_files:
      - ~/.ssh/bia-quiz.pub
    sudo: false

  - name: deploy
    system: false
    group: deploy
    home: /home/deploy
    shell: /bin/bash
    create_home: true
    home_mode: "0700"
    ssh_authorized_key_files:
      - ~/.ssh/bia-quiz-deploy.pub
    sudo: true          # writes /etc/sudoers.d/deploy with NOPASSWD:ALL

# Caddy. bia_domain must be a real public hostname whose DNS points at this server.
bia_enable_caddy: true
bia_domain: quiz.asso-triple-a.org
bia_app_port: 8080

# Debian security updates. Reboot automatically at 03:30 when required.
bia_enable_unattended_upgrades: true
bia_unattended_automatic_reboot: true
bia_unattended_reboot_time: "03:30"
bia_unattended_remove_unused_kernel_packages: true
bia_unattended_remove_new_unused_dependencies: false

# SSH brute-force protection (fail2ban sshd jail).
bia_enable_fail2ban: true
bia_fail2ban_bantime: "1h"
bia_fail2ban_findtime: "10m"
bia_fail2ban_maxretry: 5
bia_fail2ban_ignoreip: "127.0.0.1/8 ::1"

# SSH daemon port and firewall. Keep ansible_port in inventory.yml in sync after
# changing this value.
bia_manage_ssh_port: true
bia_ssh_port: 22
# Key-only SSH. Keep false unless you explicitly need password login.
bia_ssh_password_authentication: false
bia_enable_ufw: true
bia_ufw_allowed_tcp_ports:
  - "{{ bia_ssh_port }}"
  - 80
  - 443
