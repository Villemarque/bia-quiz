[Unit]
Description=bia-quiz (live BIA quiz)
Documentation=https://github.com/Villemarque/bia-quiz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bia-quiz
Group=bia-quiz
WorkingDirectory=/var/lib/bia-quiz
ExecStart=/opt/bia-quiz/bia-quiz
Environment=BIA_QUIZ_CONFIG=/etc/bia-quiz/bia.toml
StateDirectory=bia-quiz
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bia-quiz
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
