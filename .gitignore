# Build output
/target/
/frontend/node_modules/
/frontend/dist/
/.pnpm-store/
*.log

# Database, backups and import artifacts
/bia.sqlite3
/bia.sqlite3-*
/backups/
/import-report.txt

# Local secrets / machine-specific config
/bia.toml
.env

# Fetched data: the /admin URL import and `make import` download these.
/annales-bia.tsv
/data/figures/

# Non-code assets: provide the self-hosted font separately, or the UI
# falls back to the system font stack.
/frontend/static/fonts/
/charte-graphique.html

# Devenv / direnv
/.devenv/
/.direnv/
/devenv.local.nix

# Local Ansible copies; only *.example files are committed.
/deploy/artefacts/
/deploy/ansible/inventory*.yml
!/deploy/ansible/inventory.example.yml
/deploy/ansible/group_vars/*.yml
!/deploy/ansible/group_vars/*.yml.example
/deploy/ansible/host_vars/*.yml
/deploy/ansible/host_vars/*.yml.example
/deploy/ansible/*.local.yml

# OS / editor
.DS_Store
.idea/
.vscode/
